// The Playground: a test level for the player mechanics, made only of the original game's
// assets (read from the install at run time by object path; nothing is copied here).
// Format: research/dishonored/PLAYGROUND.md. Units: Unreal units, Z up, degrees.
// Floor top at z 0; player starts are pawn centres (feet + 92).
//
// Stations (south to north):
//   row 1 (y -4600 .. -2600): step heights, slopes, mantle ledges, jump gaps
//   row 2 (y -1600 ..  2400): Blink course, climbable chain, pool, fall-damage stairs (east)
//   row 3 (y  2400 ..  5600): doors and usables, lean corner, crouch tunnel, pain volume,
//                             shooting gallery, sword dummies
//   row 4 (y  6200 ..  8000): stealth lane (lit west half, roofed dark east half, a patrol)
//   start (y -5400): item and power bench, pickups
(
    name: "Playground",
    description: "Test level for the player mechanics, built from original assets.",
    packages: [
        "L_Boyle_Ext_Env",
        "L_Boyle_Ext_Audio",
        "L_Boyle_Ext_Script",
        "L_BoyleStreet_Ext_Script",
        "L_Boyle_Ext_P",
        "L_Boyle_Ext_Light",
        "L_Boyle_Int_Basement",
    ],
    environment: "L_Boyle_Ext_P",
    default_material: "Env_Blockout.materials_inst.stone_blk_192_INST",
    sky_light: 0.05,

    brushes: [
        // ---- Ground: four slabs around the pool's hole (x 1600..3600, y -1000..1000).
        (at: (-2200, 1000, -64), shape: Box((7600, 14000, 64)), material: "grounds.MASTER_street_cobbles_01_DRY_INST", uv_scale: 400),
        (at: (4800, 1000, -64), shape: Box((2400, 14000, 64)), material: "grounds.MASTER_street_cobbles_01_DRY_INST", uv_scale: 400),
        (at: (2600, -3500, -64), shape: Box((2000, 5000, 64)), material: "grounds.MASTER_street_cobbles_01_DRY_INST", uv_scale: 400),
        (at: (2600, 4500, -64), shape: Box((2000, 7000, 64)), material: "grounds.MASTER_street_cobbles_01_DRY_INST", uv_scale: 400),
        // ---- Perimeter walls (800 high).
        (at: (0, -6050, 0), shape: Box((12200, 100, 800)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (0, 8050, 0), shape: Box((12200, 100, 800)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (-6050, 1000, 0), shape: Box((100, 14200, 800)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (6050, 1000, 0), shape: Box((100, 14200, 800)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),

        // ---- Start: the item and power bench (two metal tables are original meshes below).

        // ---- A. Step heights 30 / 44 / 50 / 56 / 60 (front faces at y -3500; walk in from y -3900).
        (at: (-5400, -3200, 0), shape: Box((300, 600, 30))),
        (at: (-5000, -3200, 0), shape: Box((300, 600, 44))),
        (at: (-4600, -3200, 0), shape: Box((300, 600, 50))),
        (at: (-4200, -3200, 0), shape: Box((300, 600, 56))),
        (at: (-3800, -3200, 0), shape: Box((300, 600, 60))),

        // ---- B. Slopes 40 / 45 / 50 / 55 / 60 degrees (400 long, rising north from y -3500).
        (at: (-2800, -3500, 0), yaw: 90, shape: Ramp(width: 300, length: 400, angle: 40)),
        (at: (-2400, -3500, 0), yaw: 90, shape: Ramp(width: 300, length: 400, angle: 45)),
        (at: (-2000, -3500, 0), yaw: 90, shape: Ramp(width: 300, length: 400, angle: 50)),
        (at: (-1600, -3500, 0), yaw: 90, shape: Ramp(width: 300, length: 400, angle: 55)),
        (at: (-1200, -3500, 0), yaw: 90, shape: Ramp(width: 300, length: 400, angle: 60)),

        // ---- C. Mantle ledges 60 / 120 / 200 / 260 / 300 / 330 / 360 (front faces at y -3500).
        (at: (-400, -3200, 0), shape: Box((300, 600, 60))),
        (at: (0, -3200, 0), shape: Box((300, 600, 120))),
        (at: (400, -3200, 0), shape: Box((300, 600, 200))),
        (at: (800, -3200, 0), shape: Box((300, 600, 260))),
        (at: (1200, -3200, 0), shape: Box((300, 600, 300))),
        (at: (1600, -3200, 0), shape: Box((300, 600, 330))),
        (at: (2000, -3200, 0), shape: Box((300, 600, 360))),

        // ---- D. Jump gaps 100 / 200 / 300 / 400 / 500 between 240-high platforms; stairs up.
        (at: (2800, -4500, 0), yaw: 90, shape: Stairs(width: 300, steps: 6, rise: 40, run: 100)),
        (at: (2800, -3700, 0), shape: Box((400, 400, 240))),
        (at: (2800, -3200, 0), shape: Box((400, 400, 240))),
        (at: (3400, -4500, 0), yaw: 90, shape: Stairs(width: 300, steps: 6, rise: 40, run: 100)),
        (at: (3400, -3700, 0), shape: Box((400, 400, 240))),
        (at: (3400, -3100, 0), shape: Box((400, 400, 240))),
        (at: (4000, -4500, 0), yaw: 90, shape: Stairs(width: 300, steps: 6, rise: 40, run: 100)),
        (at: (4000, -3700, 0), shape: Box((400, 400, 240))),
        (at: (4000, -3000, 0), shape: Box((400, 400, 240))),
        (at: (4600, -4500, 0), yaw: 90, shape: Stairs(width: 300, steps: 6, rise: 40, run: 100)),
        (at: (4600, -3700, 0), shape: Box((400, 400, 240))),
        (at: (4600, -2900, 0), shape: Box((400, 400, 240))),
        (at: (5200, -4500, 0), yaw: 90, shape: Stairs(width: 300, steps: 6, rise: 40, run: 100)),
        (at: (5200, -3700, 0), shape: Box((400, 400, 240))),
        (at: (5200, -2800, 0), shape: Box((400, 400, 240))),

        // ---- E. Blink course: floor targets 500 / 1100 / 1600 east of the pad at x -5600, y 0,
        // pillars 400 / 500 / 600 high (the vertical range is 500), a 350 wall to Blink-mantle.
        (at: (-5600, 0, 0), shape: Box((200, 200, 4)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (-5100, 0, 0), shape: Box((150, 400, 4)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (-4500, 0, 0), shape: Box((150, 400, 4)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (-4000, 0, 0), shape: Box((150, 400, 4)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (-3200, -900, 0), shape: Box((300, 300, 400))),
        (at: (-3200, -300, 0), shape: Box((300, 300, 500))),
        (at: (-3200, 300, 0), shape: Box((300, 300, 600))),
        (at: (-2400, 1000, 0), shape: Box((100, 1000, 350))),

        // ---- F. Climbable chain hanging from a beam beside a 500-high tower.
        (at: (-1000, 400, 0), shape: Box((400, 400, 500))),
        (at: (-1000, 100, 560), shape: Box((60, 300, 40)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),

        // ---- G. Pool: basin 600 deep (water to 30 below the floor), stairs out in the south-west.
        (at: (2600, 0, -664), shape: Box((2000, 2000, 64)), material: "basement_set_01.basement_plaster_tile"),
        (at: (1550, 0, -664), shape: Box((100, 2200, 664)), material: "basement_set_01.basement_plaster_tile"),
        (at: (3650, 0, -664), shape: Box((100, 2200, 664)), material: "basement_set_01.basement_plaster_tile"),
        (at: (2600, -1050, -664), shape: Box((2200, 100, 664)), material: "basement_set_01.basement_plaster_tile"),
        (at: (2600, 1050, -664), shape: Box((2200, 100, 664)), material: "basement_set_01.basement_plaster_tile"),
        (at: (2440, -800, -600), yaw: 180, shape: Stairs(width: 300, steps: 14, rise: 40, run: 60), material: "basement_set_01.basement_plaster_tile"),

        // ---- H. Fall-damage stairs along the east wall (up to 1600) with ledges to drop from:
        // 880 / 1040 / 1200 / 1360 / 1520 (landing speeds about 2300 / 2500 / 2680 / 2860 / 3020).
        (at: (5700, -1600, 0), yaw: 90, shape: Stairs(width: 400, steps: 40, rise: 40, run: 100)),
        (at: (5350, 550, 0), shape: Box((300, 100, 880))),
        (at: (5350, 950, 0), shape: Box((300, 100, 1040))),
        (at: (5350, 1350, 0), shape: Box((300, 100, 1200))),
        (at: (5350, 1750, 0), shape: Box((300, 100, 1360))),
        (at: (5350, 2150, 0), shape: Box((300, 100, 1520))),

        // ---- I. Doors and usables: a wall at y 3000 with three doorways. The doors copied with yaw -90 lie along +X from their hinge (Location), 152 wide (harness "Doors and usables" table).
        (at: (-5700, 3000, 0), shape: Box((600, 40, 400)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (-5024, 3000, 0), shape: Box((448, 40, 400)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (-4324, 3000, 0), shape: Box((648, 40, 400)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (-3274, 3000, 0), shape: Box((1148, 40, 400)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),

        // ---- J. Lean corner and crouch tunnel (clearance 150: sneaking fits, standing does not).
        (at: (-1500, 3000, 0), shape: Box((1000, 40, 300))),
        (at: (-1000, 3320, 0), shape: Box((40, 600, 300))),
        (at: (-520, 3400, 0), shape: Box((40, 800, 190))),
        (at: (-280, 3400, 0), shape: Box((40, 800, 190))),
        (at: (-400, 3400, 150), shape: Box((280, 800, 40))),

        // ---- K. Pain volume floor (gravel), x 600..1400, y 2800..3600.
        (at: (1000, 3200, 0), shape: Box((800, 800, 2)), material: "ext_boyle_ground_01.gravel_01_map", collide: false),

        // ---- L. Shooting gallery: firing line y 2800; boards at 10 / 20 / 40 m (500 / 1000 / 2000).
        (at: (3400, 3300, 0), shape: Box((200, 20, 300)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (4200, 3800, 0), shape: Box((200, 20, 300)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        (at: (5000, 4800, 0), shape: Box((200, 20, 300)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),

        // ---- N. Stealth lane: a wall at y 6200 (open west of x -4400), a roof over the east half.
        (at: (300, 6200, 0), shape: Box((9400, 40, 450)), material: "boyle_brick_wall_ext.boyle_brick_wall_ext_std"),
        (at: (3000, 7100, 450), shape: Box((6000, 1800, 40)), material: "Env_Blockout.materials_inst.stone_blk_064_INST"),
        // Hiding spots: alcoves in the north wall's shadow.
        (at: (-1500, 7850, 0), shape: Box((40, 300, 300))),
        (at: (-1100, 7850, 0), shape: Box((40, 300, 300))),
        (at: (1500, 7850, 0), shape: Box((40, 300, 300))),
        (at: (1900, 7850, 0), shape: Box((40, 300, 300))),
    ],

    meshes: [
        // The bench: two metal tables by the start.
        (mesh: "table_metal_01.table_metal_01", at: (-500, -5300, 0)),
        (mesh: "table_metal_01.table_metal_01", at: (500, -5300, 0)),
        // Crates in the stealth lane (hiding spots) and by the gallery.
        (mesh: "Crate_01.Crate_01", at: (1500, 6700, 0)),
        (mesh: "Crate_01.Crate_01", at: (3200, 7400, 0), rotation: (0, 30, 0)),
        (mesh: "Crate_01.Crate_01", at: (-2500, 6800, 0), rotation: (0, 15, 0)),
        // The locker's and the bin's static bodies, under their usable parts.
        (mesh: "locker_metal_01.locker_metal_01", at: (-3200, 2700, 0), rotation: (0, -90, 0)),
        (mesh: "trash_bin_01.trash_bin_01", at: (-2800, 2700, 0)),
        // Lamps on the lit half of the stealth lane.
        (mesh: "streetlamp_01.streetlamp_big_01", at: (-3500, 6400, 0)),
        (mesh: "streetlamp_01.streetlamp_big_01", at: (-1500, 6400, 0)),
    ],

    actors: [
        // Doors: unlocked small wood, unlocked medium wood, locked small metal.
        (from: "L_Boyle_Ext_Audio:DisDoor_21", name: "Door_Wood", at: (-5400, 3000, 0), yaw: -90),
        (from: "L_Boyle_Ext_Audio:DisDoor_7", name: "Door_Reinforced", at: (-4800, 3000, 0), yaw: -90),
        (from: "L_Boyle_Ext_Audio:DisDoor_0", name: "Door_Locked", at: (-4000, 3000, 0), yaw: -90, locked: true),
        // A locker and a trash bin.
        (from: "L_Boyle_Ext_Env:DishonoredUsableObject_0", name: "Locker", at: (-3200, 2700, 0), yaw: -90),
        (from: "L_Boyle_Ext_Env:DishonoredUsableObject_13", name: "Bin", at: (-2800, 2700, 0), yaw: 0),
        // The climbable chain (Boyle basement's 400 uu chain).
        (from: "L_Boyle_Int_Basement:DisClimbable_1", name: "Chain", at: (-1000, 0, 560)),
        // Pickups by the start: elixirs, bullets, food, a rune, a bone charm, coins.
        (from: "L_Boyle_Ext_Script:DisElixirHealth_1", name: "Pickup_HealthElixir", at: (-600, -4800, 10)),
        (from: "L_BoyleStreet_Ext_Script:DisElixirMana_1", name: "Pickup_ManaElixir", at: (-400, -4800, 10)),
        (from: "L_Boyle_Ext_Script:DisStatPickup_0", name: "Pickup_Bullets", at: (-200, -4800, 10)),
        (from: "L_Boyle_Ext_Script:DisStatPickup_3", name: "Pickup_Food", at: (0, -4800, 10)),
        (from: "L_Boyle_Ext_Script:DisAbstractItemPickup_0", name: "Pickup_Rune", at: (200, -4800, 10)),
        (from: "L_BoyleStreet_Ext_Script:DisWhaleBoneCharm_1", name: "Pickup_BoneCharm", at: (400, -4800, 10)),
        (from: "L_Boyle_Ext_P:DisAbstractItemPickup_0", name: "Pickup_Coins", at: (600, -4800, 10)),
    ],

    lights: [
        // The Boyle moon (dominant directional light, shadowed).
        (from: "L_Boyle_Ext_Light:DominantDirectionalLight_1"),
        // Work lights over rows 1 to 3.
        (at: (-4000, -3800, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (0, -3800, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (4000, -3800, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (0, -5200, 600), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 2000),
        (at: (-4000, 0, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (0, 0, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (4000, 0, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 3200),
        (at: (-4000, 3600, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 2600),
        (at: (0, 3600, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 2600),
        (at: (4000, 3600, 900), color: (1.0, 0.9, 0.75), brightness: 2.0, radius: 2600),
        // The lit half of the stealth lane (street lamps).
        (at: (-3500, 6450, 420), color: (1.0, 0.8, 0.55), brightness: 4.0, radius: 1400),
        (at: (-1500, 6450, 420), color: (1.0, 0.8, 0.55), brightness: 4.0, radius: 1400),
    ],

    starts: [
