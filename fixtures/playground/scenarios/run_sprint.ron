// Run then sprint across the Playground's open floor. Reference: INSTRUMENTATION.md regression
// baseline (2026-10-06): plateaus 360 / 540 uu/s with the sword drawn.
(
    name: "playground/run_sprint",
    system: Movement,
    map: "Playground",
    description: "Run north 1.5 s, then sprint 0.75 s, west of the start.",
    setup: (player: Some((position: (-1500, -5500, 92), yaw: 90))),
    ticks: 165,
    input: [
        (tick: 30, action: Move(forward: 127, right: 0)),
        (tick: 120, hold: 44, action: Press(Sprint)),
    ],
    checkpoints: [
        (name: "run plateau", expect: [(metric: At("pawn.speed2d", 115), value: 360, tol: 1, source: "INSTRUMENTATION.md regression baseline: run 360 uu/s, sword drawn")]),
        (name: "sprint plateau", expect: [(metric: At("pawn.speed2d", 160), value: 540, tol: 1, source: "INSTRUMENTATION.md regression baseline: sprint 540 uu/s, sword drawn")]),
    ],
    record: [Pawn],
)
