// Cause book of the differential oracle (research/dishonored/ORACLE.md "Definition of done").
// Each rule classifies the work items whose id matches `matches` (`*` = any characters).
// Classified items stay in the work list with their cause; only unclassified ones block
// "done". Add a rule only with the evidence that establishes the cause.
(
    rules: [
        // Retired 2026-10-08: "u113-npc-health-rule" (sword_hit damage 14 vs 10) was a misreading.
        // The hit is the sword's Attribute_MeleeDamage 10 x the context multiplier (0x00C07C80), not
        // 0.2 x HealthMax, and guards have their archetype's HealthMax 50 (melee.md F1 / F9): ported.
        (
            id: "collision-line-backoff",
            matches: "collision:*:systematic: line *",
            kind: PortMissing,
            cause: "the engine's back-off of non-accurate line checks (the hit is reported short of the surface) is not on main's dishonored_world",
            evidence: "measured by the collision audit (worktree-agent-a6973c5492dcb391d, hit_kind::engine_time); constant 4.00 uu offset over every vision line on both Boyle maps",
        ),
    ],
)
