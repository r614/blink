// Holding lean left (Q) at the Playground's lean station (U-048, HOOK_TRIAGE.md 2026-10-06, 60 Hz,
// `CameraCache.POV`): 20 degrees held (15 + 5 soften at about 5 / s), roll 10, 14.2 degrees at
// 0.2 s; the camera 119.7 uu sideways and 21.4 down. The port's eye point is not the original's
// camera POV (another frame of reference), so the offsets are unverified.
(
    name: "movement/lean",
    system: Movement,
    map: "Playground",
    description: "Hold lean left for 2 s: angle, roll, onset, camera offset.",
    setup: (player: Some((position: (-1300, 3300, 92), yaw: 0)), settle: 20),
    ticks: 120,
    input: [(tick: 1, hold: 119, action: Press(LeanLeft))],
    checkpoints: [
        (name: "held angle", expect: [(metric: Abs(At("cam.lean_deg", 110)), value: 20, tol: 0.2, source: "HOOK_TRIAGE.md 2026-10-06 (U-048): 20 degrees held (15 + 5 soften); magnitude (sign conventions differ)")]),
        (name: "roll", expect: [(metric: Abs(At("cam.roll", 110)), value: 10, tol: 0.2, source: "HOOK_TRIAGE.md 2026-10-06 (U-048): roll 10 (m_fCameraTiltPercent 0.5); magnitude")]),
        (name: "onset", expect: [(metric: Abs(At("cam.lean_deg", 13)), value: 14.2, tol: 0.5, source: "HOOK_TRIAGE.md 2026-10-06: 14.2 degrees at 0.2 s (12 ticks after the press)")]),
        (name: "sideways", expect: [(metric: Abs(Delta("cam.y", 0, 110)), value: 119.7, tol: 2, source: "HOOK_TRIAGE.md 2026-10-06: CameraCache.POV 119.7 uu sideways (camera POV vs the port's eye point)", status: Unverified)]),
        (name: "down", expect: [(metric: Delta("cam.z", 0, 110), value: -21.4, tol: 2, source: "HOOK_TRIAGE.md 2026-10-06: CameraCache.POV 21.4 uu down", status: Unverified)]),
    ],
    record: [Pawn, Camera],
    capture: Some("measure lean (CameraCache.POV per tick)"),
)
