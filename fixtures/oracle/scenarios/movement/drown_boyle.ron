// Held under the Boyle sea (U-242, HOOK_TRIAGE.md 2026-10-06: air 30 s, then 1 point per 61 ticks,
// the under-water flag follows the camera at the volume top, U-244). A swimmer has no gravity in deep
// water (Buoyancy 1.0), so the pawn placed 180 uu under the surface with no input stays there.
// Same checks as movement/drown, on the map the original runs.
(
    name: "movement/drown_boyle",
    system: Movement,
    map: "L_Boyle_Ext_P",
    description: "Stay under the Boyle sea: the first health loss after 30 s of air, ten losses 61 ticks apart.",
    setup: (player: Some((position: (-4500, 4000, -2250), yaw: 0, pitch: 0))),
    tick_hz: 60,
    ticks: 2500,
    input: [],
    checkpoints: [
        (name: "swimming", expect: [(metric: TimeAt("pawn.mode", 5), value: 1, tol: 0, cmp: AtMost, source: "a pawn in a deep water volume swims (PHYS_Swimming)", status: Static)]),
        (name: "air", expect: [(metric: Gap(TimeToReach("pawn.under", 1), TimeBelow("pawn.health", 69.5)), value: 30.0, tol: 0.034, source: "HOOK_TRIAGE.md 2026-10-06 (U-242): air 30 s")]),
        (name: "drowning rate", expect: [(metric: Gap(TimeBelow("pawn.health", 69.5), TimeBelow("pawn.health", 59.5)), value: 10.1667, tol: 0.034, source: "HOOK_TRIAGE.md 2026-10-06 (U-242): 1 point per 61 ticks")]),
    ],
    record: [Pawn, Vitals],
    tolerances: [("pawn.", 0.5)],
    capture: Some("lab setup 60; place at (-4500, 4000, -2250) no snap; no input; sample +0x8A0 bit 11 and Health per tick"),
)