// Sprint into a slide into a sneak (sword drawn, 60 Hz). Rules (PLAYER.md "Slide", decoded
// 0x00A67FA0 / 0x00A6F440): sprint 600 x 0.9 = 540 uu/s; Crouch while sprinting at 400 uu/s or
// more starts a slide: v = v0 + (target - v0) (1 - cos(pi t / 1.1)) / 2 to the sneak speed
// 275 x 0.9 = 247.5 over 1.1 s (INSTRUMENTATION.md, sheathed: 600 -> 275, 434.7 at 0.555 s,
// 483 uu); afterwards the pawn sneaks at 247.5.
(
    name: "movement/sprint_slide",
    system: Movement,
    map: "L_Boyle_Ext_P",
    description: "Run, sprint, press Crouch at sprint speed: the slide curve, then sneak speed.",
    setup: (player: Some((position: (-3400, -3150, -190), yaw: 270, snap_to_floor: true, sword_drawn: true))),
    tick_hz: 60,
    ticks: 130,
    input: [
        (tick: 10, action: Move(forward: 127, right: 0)),
        (tick: 15, hold: 90, action: Press(Sprint)),
        (tick: 45, action: Press(Crouch)),
    ],
    checkpoints: [
        (name: "sprint plateau", expect: [(metric: At("pawn.speed2d", 44), value: 540, tol: 1.5, source: "PLAYER.md: 600 x 0.9, INSTRUMENTATION.md regression baseline 540", status: Static)]),
        (name: "slide midpoint", expect: [(metric: At("pawn.speed2d", 78), value: 393.75, tol: 4, source: "0x00A6F440: 540 + (247.5 - 540) x 0.5 at half of m_fSlideTime (33 ticks after the press)", status: Static)]),
        (name: "sneak speed", expect: [(metric: At("pawn.speed2d", 125), value: 247.5, tol: 1.5, source: "PLAYER.md: Attribute_GroundSpeedCrouch 275 x 0.9", status: Static)]),
    ],
    record: [Pawn],
    tolerances: [("pawn.", 0.5)],
    capture: Some("lab setup 60; lab equip DisWepMelee 1; tick script: W from 10, LeftShift 15-105, C tap at 45; Pawn channels"),
)