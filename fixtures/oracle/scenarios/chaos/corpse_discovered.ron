// NumCorpsesDiscovered (research/dishonored/systems/world.md 2.1): an NPC's corpse reaction
// reports a discovery (0x00B40740 -> 0x00A98950), which raises the stat only the first time a
// given corpse is discovered (a set of discovered corpses is checked). Deed 8 (m_Deeds[8]:
// NumCorpsesDiscovered, m_Threshold 5, m_Value 6) needs five, so one corpse adds no score.
// The guard (factionless, in the Playground's patrol lane) walks away from the body when the kill
// happens behind it, so it does not witness it, and finds the corpse by sight on its way back.
(
    name: "chaos/corpse_discovered",
    system: Chaos,
    map: "Playground",
    description: "Kill a civilian out of a patrolling guard's sight; the guard walks up and finds the body: one corpse discovered, once, no chaos yet.",
    setup: (
        player: Some((position: (-1420, 7100, 96), yaw: 0, pitch: 0)),
        npcs: [
            (id: Some("civ"), kind: Some("Civilian"), position: Some((-1300, 7100, 92)), yaw: 0, state: Some("Passive")),
            (id: Some("guard"), position: Some((-1000, 7100, 92)), yaw: 0, state: Some("Patrol"), faction: Some("None"), route: [(1000, 7100, 92), (-1000, 7100, 92)]),
        ],
        settle: 5,
    ),
    ticks: 1500,
    input: [
        (tick: 5, action: Press(Primary)),
        (tick: 150, action: Console("teleport 0 -5500 92 90")),
    ],
    checkpoints: [
        (name: "killed", expect: [(metric: Count("Sim:Death@civ"), value: 1, tol: 0, source: "setup: back assassination", status: Static)]),
        (name: "found once", expect: [(metric: Final("darkness.corpses_found"), value: 1, tol: 0, source: "0x00A98950: NumCorpsesDiscovered only for a corpse not in the discovered set", status: Static)]),
        (name: "no chaos from one corpse", expect: [(metric: Final("darkness.score"), value: 6, tol: 0, source: "the civilian kill's deed 0 (+6); deed 8 counter 1 < m_Threshold 5", status: Static)]),
    ],
    record: [Pawn, Npc("guard"), Npc("civ"), SimEvents],
    capture: Some("session: kill an NPC out of sight of a patrolling guard whose route passes the body; read the stats object's NumCorpsesDiscovered and DisDarknessManager m_DeedCounters[8] (+0x3C) when the guard reacts"),
)
