// Chaos from guard kills (research/dishonored/systems/world.md 2.1): deed 2 (m_Deeds[2]:
// NumKills, m_Threshold 4, m_Value 6, victim Pwn_Guard_Base) counts guard kills and adds 6 on
// every fourth, resetting its counter (0x00C4D2C0, no carry). The port's scenario guards are
// mission NPCs whose victim tweak is their role's base tweak (Pwn_Guard_Base).
(
    name: "chaos/guard_kills_sweep",
    system: Chaos,
    map: "Playground",
    description: "Assassinate four guards from behind: the score stays 0 for three kills and becomes 6 on the fourth.",
    setup: (
        player: Some((position: (-5300, 0, 96), yaw: 180, pitch: 0)),
        npcs: [
            (id: Some("g1"), position: Some((-5420, 0, 92)), yaw: 180, state: Some("Passive")),
            (id: Some("g2"), position: Some((-5420, 800, 92)), yaw: 180, state: Some("Passive")),
            (id: Some("g3"), position: Some((-5420, -800, 92)), yaw: 180, state: Some("Passive")),
            (id: Some("g4"), position: Some((-5420, 1600, 92)), yaw: 180, state: Some("Passive")),
        ],
        settle: 30,
    ),
    ticks: 820,
    input: [
        (tick: 5, action: Press(Primary)),
        (tick: 200, action: Console("teleport -5300 800 96 180")),
        (tick: 210, action: Press(Primary)),
        (tick: 400, action: Console("teleport -5300 -800 96 180")),
        (tick: 410, action: Press(Primary)),
        (tick: 600, action: Console("teleport -5300 1600 96 180")),
        (tick: 610, action: Press(Primary)),
    ],
    checkpoints: [
        (name: "kills", expect: [(metric: Count("Sim:Death"), value: 4, tol: 0, source: "setup: four assassinations", status: Static)]),
        (name: "three kills", expect: [(metric: At("darkness.score", 595), value: 0, tol: 0, source: "deed 2 counter 3 < m_Threshold 4", status: Static)]),
        (name: "fourth kill", expect: [
            (metric: Final("darkness.score"), value: 6, tol: 0, source: "deed 2: the fourth kill adds m_Value 6 and resets the counter (0x00C4D2C0)", status: Static),
            (metric: Final("darkness.level"), value: 0, tol: 0, source: "6 < m_DarknessLevels[1] = 12", status: Static),
        ]),
    ],
    record: [Pawn, SimEvents],
    capture: Some("session: four unaware guards (Pwn_Guard_Base descendants); assassinate each, read DisDarknessManager +0x38 and m_DeedCounters[2] (+0x3C) after each"),
)
