// (m_fEffectiveMassForThrowing 2.0, 0x00BEB6E0).
(
    name: "physics/windblast_throw_d900",
    system: Physics,
    map: "L_Boyle_Ext_P",
    description: "Windblast level 1 at an idle guard 900 uu ahead: |momentum| 946, between 500 and 1000: a strong hit reaction, no throw expected.",
    setup: (
        player: Some((position: (-3400, -3150, -190), yaw: 270, snap_to_floor: true)),
        powers: [("WindBlast", 1)],
        left_hand: Some("Windblast"),
        npcs: [(id: Some("guard"), spawner: Some("DishonoredSpawner_46"), position: Some((-3400, -4050, -217.5)), yaw: 90, state: Some("Idle"), faction: Some("None"))],
        settle: 30,
