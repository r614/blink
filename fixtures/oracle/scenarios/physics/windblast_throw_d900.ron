    ticks: 240,
    input: [(tick: 5, action: Press(Secondary))],
    checkpoints: [
        (name: "damage", expect: [(metric: EventValue("Sim:Damage@guard[cause=Windblast]", "amount"), value: 10, tol: 1, source: "Twk_WindBlast m_Levels[0].m_Damage 20 x k (round); k = (1 - d3/3000)^2 with d3 = 901", status: Static)]),
        (name: "reaction class", expect: [(metric: Max("npc.guard.physics"), value: 1, tol: 0, cmp: AtMost, source: "|momentum| 946 < 1000 (threshold consumer not decoded); a throw would show physics 4", status: Unmeasured)]),
