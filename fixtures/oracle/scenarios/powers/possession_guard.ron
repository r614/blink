// target's `Twk_Possessable_BaseNPC.m_pTargetingHighlightEffect` = `PossesTarget_Human_01`
// while targeting.
(
    name: "powers/possession_guard",
    system: Powers,
    map: "Playground",
    description: "Hold Possession on a guard 300 uu ahead for 0.5 s, release: the possession starts, mana, and the cast / targeting effects.",
    setup: (
        player: Some((position: (-5600, 0, 96), yaw: 0)),
        powers: [("Possess", 2)],
        left_hand: Some("Possession"),
        npcs: [(id: Some("guard"), position: Some((-5300, 0, 92)), yaw: 0, state: Some("Idle"), faction: Some("None"))],
        settle: 30,
