// The Playground stealth lane (navmeshed; the y = 0 runway has no navmesh). A default-faction
// guard (an enemy of Corvo) facing away hears a pistol shot 3800 uu behind it (Pistol noise radius
// 4000, so heard) from beyond its vision range (3500 uu): hearing alone sends it to investigate.
// The heard noise raises attention on its instigator, the player (proxy at the shot; measured on
// the original, ai/boyle_hear_shot), and the attention poster's SearchBegin (no delay) starts
// DisBehaviorSearch's Investigate on the next brain tick. A neutral guard would not search (the
// poster posts nothing for a non-enemy top target).
//
// MOVED from the Playground to Boyle Ext (round 8): the original Playground has no navmesh, so the
// hostile guard never walked to the shot there. Placement: the quiet flat navmesh diagonal of the
// south-west yard (floor z -1317; `oracle navlines`, nothing within 800 uu), direction 112.5 deg:
// the shooter at (-8155, -9576), the guard 3200 uu ahead at (-9379.5, -6619.7) facing away (the
// Playground had 3800; the longest clean line on Boyle is 3450, so the guard is inside the 3500 uu
// vision range but faces away: the "stays below Busted" bound is what the original now measures).
// The walk to the shot runs along the diagonal: x increases (it was decreasing on the Playground),
// so the bound is Max(x) >= shot.x + 0.3827 * 250 = -8250 (the same 250 uu proximity).
(
    name: "ai/investigate_noise",
    system: Ai,
    map: "L_Boyle_Ext_P",
    description: "Fire the pistol 3800 uu behind a hostile guard, out of its sight: it investigates the shot.",
    setup: (
        player: Some((position: (-8155, -9576, -1221), yaw: 112.5, pitch: 60, snap_to_floor: true)),
        items: ["Bullet:5"],
        left_hand: Some("Pistol"),
        npcs: [(id: Some("guard"), position: Some((-9379.5, -6619.7, -1217)), yaw: 112.5, state: Some("Idle"), faction: Some("DisFaction_Defaults.Faction_Guard_Default"))],
        settle: 120,
    ),
    ticks: 900,
    input: [(tick: 5, action: Press(Secondary))],
    checkpoints: [
        (name: "heard: Investigate, not more", expect: [(metric: At("npc.guard.attn", 8), value: 0.6, tol: 0.01, source: "AI.md (0x00b60ca0, CONFIRMED): a Danger sound adds 0.4 and floors the value at Investigate's start 0.6 (guard unsuspecting profile toward an enemy); hearing cannot raise attention above Investigate", status: Static)]),
        (name: "investigates", expect: [(metric: TimeAt("npc.guard.state", 7), value: 15, tol: 0, cmp: AtMost, source: "a danger noise in hearing range sends a guard to investigate (DisAISubStateInvestigate)", status: Static)]),
        (name: "hearing stays below Busted", expect: [(metric: At("npc.guard.attn_level", 60), value: 3, tol: 0, cmp: AtMost, source: "the player is 3200 uu away (Boyle placement; 3800 on the Playground, beyond the 3500 uu vision range of Twk_Vision_Default) and the guard faces away, and Heard cannot raise attention to Busted; the guard sees the player once it has run to the shot", status: Static)]),
        (name: "walks to the shot", expect: [(metric: Max("npc.guard.x"), value: -8250, tol: 0, cmp: AtLeast, source: "DisAISubStateInvestigate goes to the attention proxy (the shot, proximity 250 uu) within 900 ticks: 3200 uu at run speed takes under 10 s", status: Static)]),
        (name: "search starts on the next brain tick", expect: [(metric: Gap(FirstAt("Sim:Fired"), TimeAt("npc.guard.state", 7)), value: 0.0167, tol: 0.02, source: "the attention poster (0x00b25890 / 0x00b24d00) posts SearchBegin when the behaviour level steps to Investigate; its stimulus class's delay getter returns 0 (0x008fc830, vtable 0x01134478 +8), so the queue (0x00b148c0 / 0x00b16eb0) releases it at once. m_ReactionDelay belongs to SearchRequest / Help only (delay getter 0x00b01650, vtables 0x01134100 / 0x01134118)", status: Static)]),
    ],
    record: [Pawn, Npc("guard"), SimEvents],
    capture: Some("fire the pistol behind a hostile Boyle guard out of sight: guard position and brain channels per tick"),
)
