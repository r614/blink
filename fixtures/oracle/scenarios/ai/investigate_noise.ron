// A factionless guard facing away hears a pistol shot 3800 uu behind it (Pistol noise radius
// 4000, so heard) from beyond its vision range (3500 uu): hearing alone sends it to investigate.
// Nothing here is seen, so the attention comes from the noise only (`attn_noise`: the place
// entry), and the brain goes React (m_ReactionDelay 0.18-0.30 s) -> Investigate.
(
    name: "ai/investigate_noise",
    system: Ai,
    map: "Playground",
    description: "Fire the pistol 3800 uu behind a guard, out of its sight: it reacts, then investigates.",
    setup: (
        player: Some((position: (-5600, 0, 96), yaw: 0, pitch: 60)),
        items: ["Bullet:5"],
        left_hand: Some("Pistol"),
        npcs: [(id: Some("guard"), position: Some((-1800, 0, 92)), yaw: 0, state: Some("Idle"), faction: Some("None"))],
        settle: 120,
    ),
    ticks: 900,
    input: [(tick: 5, action: Press(Secondary))],
    checkpoints: [
        (name: "heard: Investigate, not more", expect: [(metric: At("npc.guard.attn_noise", 8), value: 0.6, tol: 0.01, source: "AI.md (0x00b60ca0, CONFIRMED): a Danger sound adds 0.4 and floors the value at Investigate's start 0.6; hearing cannot raise attention above Investigate", status: Static)]),
        (name: "investigates", expect: [(metric: TimeAt("npc.guard.state", 7), value: 15, tol: 0, cmp: AtMost, source: "a danger noise in hearing range sends a guard to investigate (DisAISubStateInvestigate)", status: Static)]),
        (name: "player never perceived", expect: [(metric: Max("npc.guard.attn_level"), value: 0, tol: 0, cmp: AtMost, source: "the player is 3800 uu away, beyond the 3500 uu vision range, so no sight attention accrues (Twk_Vision_Default)", status: Static)]),
        (name: "walks to the shot", expect: [(metric: Min("npc.guard.x"), value: -5350, tol: 0, cmp: AtMost, source: "DisAISubStateInvestigate goes to the attention proxy (the shot, proximity 250 uu, m_fSearchReachedProxyLocEqualsRange) within 900 ticks: 3800 uu at run speed takes under 10 s", status: Static)]),
        (name: "reaction delay", expect: [(metric: Gap(FirstAt("Sim:Fired"), TimeAt("npc.guard.state", 4)), value: 0.02, tol: 0.05, source: "stimulus -> React is the next tick (stim queued with the global reaction delay m_ReactionDelay 0.18-0.30, DefaultAI.ini)", status: Unmeasured)]),
        (name: "react lasts the reaction delay", expect: [(metric: Gap(TimeAt("npc.guard.state", 4), TimeAt("npc.guard.state", 7)), value: 0.24, tol: 0.09, source: "(one tick of sampling slack) DishonoredGlobalAIManager.m_ReactionDelay = (0.18, 0.30) in DefaultAI.ini (0x00b16eb0 releases a queued stimulus when its delay is <= 0)", status: Static)]),
    ],
    record: [Pawn, Npc("guard"), SimEvents],
    capture: Some("fire the pistol behind a Boyle party guard out of sight: guard position per tick (ai/boyle_hear_shot)"),
)
